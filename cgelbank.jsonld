    {
      "@id": "urn:cgel:ewt:newsgroup-groups.google.com_herpesnation_c74170a0fcfdc880_ENG_20051125_075200-0024",
      "@type": "Tree",
      "source": "datasets/ewt.cgel",
      "sentId": "newsgroup-groups.google.com_herpesnation_c74170a0fcfdc880_ENG_20051125_075200-0024",
